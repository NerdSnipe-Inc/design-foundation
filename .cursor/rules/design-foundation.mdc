### Lists & Data
```swift
DFList(items) { item in DFListRow(title: item.title, subtitle: item.subtitle) }   // also selection:, onDelete:, onMove:
DFListRow(title: "Title", subtitle: "Detail", showDisclosure: true, leading: { Image(systemName: "folder.fill") })  // label required, ambiguous otherwise
// title: always required; no icon:/accessory: params.
// Annotate the columns array element type (e.g. [DFTableColumn<Contact>]) — without it,
// Swift can't infer the closure parameter's type.
let columns: [DFTableColumn<Contact>] = [DFTableColumn(id: "name", title: "Name") { $0.name }]
DFTable(data: contacts, columns: columns)        // data:, not rows:
DFDataGrid(data: contacts, columns: [DFDataGridColumn<Contact>(id: "name", title: "Name") { $0.name }])
DFDataTable(data: contacts, columns: columns, selectionMode: .single, filterQuery: query)   // native Table: selection:, selectionMode: .none/.single/.multiple, filterQuery:, onSort:, onRowActivate:, emptyContent:
DFDataGrid(data: contacts, columns: [DFDataGridColumn<Contact>(id: "name", title: "Name", editable: true) { $0.name }],
           largeDatasetStrategy: .paged(pageSize: 25))   // adds editable cells, column visibility, paging, bulkToolbar:

// Calendar & empty state — respects @Environment(\.calendar)/\.locale; dayContent defaults to EmptyView()
DFCalendarView(selection: $selectedDate, minimumDate: Date()) { date in
    if hasEvent(on: date) { Circle().fill(DFTheme.default.colors.primary).frame(width: 4, height: 4) }
}
DFEmptyState(icon: "tray", title: "No results", message: "Try a different filter.", actionTitle: "Clear", onAction: { clear() })
// icon/title required; message/actionTitle/onAction independent optionals. Only .standard style ships.
// secondaryActionTitle/onSecondaryAction add a 2nd ghost button — this covers permission-prompt
// two-choice screens too; there's no separate DFPermissionPromptView component.
DFEmptyState(icon: "bell.badge", title: "Enable notifications", actionTitle: "Allow", onAction: { requestNotificationPermission() }, secondaryActionTitle: "Not Now", onSecondaryAction: { dismissPrompt() })
```

