DFRatingView(value: 4.5)           // styles: .stars(default)/.numeric; mode: .readOnly(default)/.interactive(onChange:)
DFPriceView(amount: 34.99, compareAtAmount: 49.99)   // styles: .standard(default)/.compact
DFPriceSummaryView(lineItems: [DFPriceLineItem(label: "Total", amount: 94.96, emphasis: .total)])
DFCard { content }                 // no padding: param; DFCard(action: { }) { } makes it interactive
DFEntityRow(media: .avatarInitials("JL"), title: "Jordan Lee", trailing: .chevron)   // vs DFListRow: fixed media/trailing vocabulary, not arbitrary views
