DFMetadataRow(items: [DFMetadataItem(systemImage: "clock", label: "5 min read")])
DFArticleRow(title: "SwiftUI in 2026", authorName: "Jordan Lee", authorInitials: "JL", date: publishedDate, tags: ["Swift"])

// Bottom bar, radio picker, image gallery
ScrollView { /* ... */ }.dfBottomBar { DFButton("Continue") { } }   // pins content to bottom on a themed surface
DFRadioPickerView(options: [DFRadioPickerOption(id: "sm", label: "Small")], selection: $sizeSelection)   // inline list, vs DFPicker's menu/wheel
YourView().dfImageGallery(isPresented: $showGallery, images: [image1, image2, image3], initialIndex: 1)   // full-screen swipeable viewer
